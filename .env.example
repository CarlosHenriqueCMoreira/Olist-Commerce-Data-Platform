# Copie para .env (cp .env.example .env). O .env NÃO é versionado.
POSTGRES_HOST=localhost
# 5433 evita conflito com um PostgreSQL já instalado na máquina (5432)
POSTGRES_PORT=5433
POSTGRES_DB=olist
POSTGRES_USER=olist
POSTGRES_PASSWORD=change_me

# Opcional: pasta com os CSVs (padrão: data/raw)
# OLIST_DATA_DIR=data/raw
